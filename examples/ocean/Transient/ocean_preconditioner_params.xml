<ParameterList name="Algebraic Preconditioner">
  <Parameter name="Method" type="string" value="Ifpack"/>
  <Parameter name="Ifpack Method" type="string" value="Amesos stand-alone"/>
  <Parameter name="amesos: solver type" type="string" value="Amesos_Mumps"/>

  <!-- General Amesos settings -->
  <Parameter name="OutputLevel" type="int" value="1"/>
  <Parameter name="PrintTiming" type="bool" value="true"/>
  <Parameter name="PrintStatus" type="bool" value="false"/>

  <!-- MUMPS parameters forwarded by Amesos -->
  <ParameterList name="mumps">
    <!-- error stream: stdout=6, none=-1 -->
    <Parameter name="ICNTL(1)" type="int" value="6"/>
    <!-- info stream: stdout=6, none=-1 -->
    <Parameter name="ICNTL(2)" type="int" value="-1"/>
    <!-- global info stream: stdout=6, none=-1 -->
    <Parameter name="ICNTL(3)" type="int" value="6"/>
    <!-- verbosity (-1..3) -->
    <Parameter name="ICNTL(4)" type="int" value="1"/>
    <!-- collect statistics (set to 0 for optimal performance) -->
    <Parameter name="ICNTL(11)" type="int" value="0"/>
  </ParameterList>
</ParameterList>
